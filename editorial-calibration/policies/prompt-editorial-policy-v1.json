  "rules": [
    {
      "ruleId": "suspense-reversal-solution-arc",
      "name": "悬念—转折—解法—兑现",
      "distilledRule": "先给有证据的异常结果或未解动作，再按来源允许的顺序揭示原因、受挫或方向变化、用户痛点、产品选择、分发动作和结果；每一步都回答上一段问题并产生下一段具体疑问。",
      "sourceFindings": [
        {
          "sampleId": "xhs-6a7b007600000000240264dc",
          "recordVersion": "1.0.0",
          "patternIds": ["outcome-mechanism-origin-growth", "question-led-phase-bridges"]
        },
        {
          "sampleId": "xhs-6809f616000000000903a1fb",
          "recordVersion": "1.0.0",
          "patternIds": ["double-outcome-link-question", "success-failure-reorientation-turn"]
        }
      ],
      "sourceFeedbackSignalIds": ["suspense-reversal-solution-marketing-arc"],
      "applicableRoles": ["story-director", "script-writer", "retention-critic"],
      "guardrails": [
        "受挫、心理状态、动机、增长原因和结果必须由 Claim 支持，不能为起伏补写。",
        "不是每期都必须有危机；资料没有反转时用有证据的选择、限制或判断变化推进。"
      ]
    },
    {
      "ruleId": "result-proof-curiosity-hook",
      "name": "结果、同期证明与继续观看问题",
      "distilledRule": "前三秒用零背景可懂的结果、动作或反应建立 stakes，并尽快给出一种不重复的同期证明；保留一个与机制、选择或用户后果有关的问题，而不是只堆金额、年龄或品牌名。",
      "sourceFindings": [
        {
          "sampleId": "xhs-6a7b007600000000240264dc",
          "recordVersion": "1.0.0",
          "patternIds": ["outcome-mechanism-origin-growth"]
        },
        {
          "sampleId": "xhs-6a7091e400000000250032e2",
          "recordVersion": "1.0.0",
          "patternIds": ["reaction-mystery-open-loop"]
        },
        {
          "sampleId": "xhs-6a75e71a00000000210235f0",
          "recordVersion": "1.0.0",
          "patternIds": ["proof-stack-before-explanation"]
        }
      ],
      "sourceFeedbackSignalIds": ["suspense-reversal-solution-marketing-arc"],
      "applicableRoles": ["viral-director", "audience-critic"],
      "guardrails": [
        "证明必须可追溯、彼此承担不同作用，不能用多个数字重复同一主张。",
        "真实反应只能用于其原始情境，不能重排为产品效果证明。"
      ]
    },
    {
      "ruleId": "progressive-question-bridges",
      "name": "逐段回答的疑问桥",
      "distilledRule": "用自然疑问或未完成动作连接阶段：后段必须及时回答前段留下的问题，并用新增动作、证据或判断继续推进；口播改写需保留这些转折，不把它们抹平成时间线。",
      "sourceFindings": [
        {
          "sampleId": "xhs-6a7b007600000000240264dc",
          "recordVersion": "1.0.0",
          "patternIds": ["question-led-phase-bridges"]
        },
        {
          "sampleId": "xhs-6a7091e400000000250032e2",
          "recordVersion": "1.0.0",
          "patternIds": ["late-reveal-reframes-footage"]
        }
      ],
      "sourceFeedbackSignalIds": ["suspense-reversal-solution-marketing-arc"],
      "applicableRoles": ["viral-director", "script-writer", "oral-rewriter", "retention-critic"],
      "guardrails": [
        "不能连续堆叠空问题或机械反问；每个问题都要有计划中的证据答案。",
        "不能延后会改变事实准确、授权或合规判断的关键条件。"
      ]
    },
    {
      "ruleId": "interaction-before-abstraction",
      "name": "先看懂用户动作，再讲抽象规模",
      "distilledRule": "在公司历史、平台规模或市场判断之前，先让观众看懂一个具体痛点、输入、产品动作、反馈或使用规则；抽象结论必须能回到这个可见体验。",
      "sourceFindings": [
        {
          "sampleId": "xhs-6a7b007600000000240264dc",
          "recordVersion": "1.0.0",
          "patternIds": ["outcome-mechanism-origin-growth"]
