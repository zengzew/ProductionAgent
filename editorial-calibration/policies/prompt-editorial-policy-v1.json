    {
      "ruleId": "pain-product-distribution-result-chain",
      "name": "痛点—产品—分发—结果链",
      "distilledRule": "把用户的具体痛点、团队的产品选择、用户可见动作、获客或传播方式和可验证结果连成一条可追踪链；如果来源只支持先后顺序，就明确写成 sequence-only。",
      "sourceFindings": [
