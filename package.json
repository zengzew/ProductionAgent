{
  "name": "product-story-video-lab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A director-driven, artifact-based studio for sourced Chinese AI product-story videos.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:research": "tsx scripts/validate-research.ts",
    "validate:workflow": "tsx scripts/validate-workflow.ts",
    "validate:story": "pnpm validate:workflow && tsx scripts/validate-story.ts",
    "materialize:story": "tsx scripts/materialize-story.ts",
    "polish": "tsx scripts/polish-script.ts",
    "ab:compare": "tsx scripts/run-ab.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "capture": "tsx scripts/capture-assets.ts",
    "tts": "tsx scripts/generate-tts.ts",
    "timeline": "tsx scripts/build-timeline.ts",
    "render:smoke": "tsx scripts/render.ts smoke",
    "render:vertical": "tsx scripts/render.ts vertical",
    "inspect:output": "tsx scripts/inspect-output.ts",
    "validate:comparison": "tsx scripts/validate-comparison.ts",
    "validate:delivery": "tsx scripts/validate-delivery.ts",
    "render": "pnpm render:vertical"
  },
  "dependencies": {
    "@langchain/core": "1.2.4",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.3",
    "@remotion/media": "4.0.500",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.500",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "4.0.500",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
