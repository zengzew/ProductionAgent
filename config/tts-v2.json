{
  "defaultProvider": "minimax",
  "fallbackProvider": "edge",
  "fallbackOnMissingCredential": true,
  "fallbackOnError": true,
  "network": {
    "timeoutMs": 30000,
    "maxRetries": 2,
    "retryBaseDelayMs": 250
  },
  "normalization": {
    "integratedLufs": -16,
    "truePeakDb": -1.5,
    "loudnessRange": 7,
    "sampleRate": 48000,
    "bitrate": "192k"
  },
  "providers": {
    "minimax": {
      "label": "MiniMax Speech via Alibaba Cloud Model Studio",
      "apiStyle": "aliyun-bailian",
      "endpoint": "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation",
      "apiKeyEnv": "QWEN_API_KEY",
      "model": "MiniMax/speech-2.8-hd",
      "voice": "Chinese (Mandarin)_Reliable_Executive",
      "speed": 1.65,
      "pitch": 0,
      "volume": 1,
      "languageBoost": "Chinese",
      "requestTimestamps": true
    },
    "edge": {
      "label": "Microsoft Edge neural TTS",
      "voice": "zh-CN-YunjianNeural",
      "speed": 1.25,
      "pitch": "-2Hz"
    }
  }
}
