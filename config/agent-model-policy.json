{
  "schemaVersion": "agent-model-policy-v2",
  "policyVersion": "role-model-rollout-v1",
  "defaults": {
    "mode": "manual",
    "fallbackMode": "none",
    "provider": "openai-compatible",
    "endpoint": "https://api.openai.com/v1/chat/completions",
    "model": "gpt-5-mini",
