{
  "schemaVersion": "model-benchmark-config-v1",
  "policyVersion": "role-model-rollout-v1",
  "allowedRoles": [
    "story-director",
    "viral-director",
    "script-writer",
    "oral-rewriter",
    "oral-judge",
    "audience-critic",
    "fact-guardian",
    "retention-critic"
  ],
  "defaultModelSet": "default",
  "modelSets": {
    "default": ["deepseek-v4-flash", "qwen3-7-plus", "minimax-m2-7"]
  },
  "candidates": {
    "deepseek-v4-flash": {
      "provider": "openai-compatible",
      "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      "model": "deepseek-v4-flash-0731",
      "reasoning": {
        "profile": "deepseek-v4-flash",
        "enable_thinking": true,
        "reasoning_effort": "max"
      },
      "temperature": 0.4,
      "capabilities": ["text"],
      "apiKeyEnv": "QWEN_API_KEY",
      "allowedOrigins": ["https://dashscope.aliyuncs.com"],
      "timeoutMs": 300000,
      "maxRetries": 0
    },
    "qwen3-7-plus": {
      "provider": "openai-compatible",
      "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      "model": "qwen3.7-plus",
      "reasoning": {
        "profile": "qwen3.7-plus",
        "enable_thinking": true,
        "thinking_budget": 262144
      },
      "temperature": 0.4,
      "capabilities": ["text"],
      "apiKeyEnv": "QWEN_API_KEY",
      "allowedOrigins": ["https://dashscope.aliyuncs.com"],
      "timeoutMs": 300000,
      "maxRetries": 0
    },
    "minimax-m2-7": {
      "provider": "aliyun-bailian",
      "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      "model": "MiniMax/MiniMax-M2.7",
      "reasoning": {
        "profile": "minimax-m2.7",
        "mode": "native-thinking-only"
      },
      "temperature": 0.4,
      "capabilities": ["text"],
      "apiKeyEnv": "QWEN_API_KEY",
      "allowedOrigins": ["https://dashscope.aliyuncs.com"],
      "timeoutMs": 300000,
      "maxRetries": 0
    }
  }
}
