[
  {
    "index": 1,
    "sceneId": "seg-001",
    "startSeconds": 0,
    "endSeconds": 2.1599999999999997,
    "startFrame": 0,
    "endFrame": 65,
    "text": "提醒吃药 问球赛结果"
  },
  {
    "index": 2,
    "sceneId": "seg-001",
    "startSeconds": 2.1599999999999997,
    "endSeconds": 3.5999999999999996,
    "startFrame": 65,
    "endFrame": 108,
    "text": "出门前看天气"
  },
  {
    "index": 3,
    "sceneId": "seg-002",
    "startSeconds": 3.95,
    "endSeconds": 6.87992,
    "startFrame": 119,
    "endFrame": 206,
    "text": "这些请求原本发给\n一个邮件助手"
  },
  {
    "index": 4,
    "sceneId": "seg-002",
    "startSeconds": 6.87992,
    "endSeconds": 9.182,
    "startFrame": 206,
    "endFrame": 275,
    "text": "后来 它住进了联系人列表"
  },
  {
    "index": 5,
    "sceneId": "seg-003",
    "startSeconds": 9.532,
    "endSeconds": 11.29490909090909,
    "startFrame": 286,
    "endFrame": 339,
    "text": "Poke 是个 AI 助手"
  },
  {
    "index": 6,
    "sceneId": "seg-003",
    "startSeconds": 11.29490909090909,
    "endSeconds": 14.115563636363635,
    "startFrame": 339,
    "endFrame": 423,
    "text": "但它的主要入口\n不在一个新 App 里"
  },
  {
    "index": 7,
    "sceneId": "seg-003",
    "startSeconds": 14.115563636363635,
    "endSeconds": 16.583636363636362,
    "startFrame": 423,
    "endFrame": 498,
    "text": "它就是手机联系人里的\n一个名字"
  },
  {
    "index": 8,
    "sceneId": "seg-003",
    "startSeconds": 16.583636363636362,
    "endSeconds": 19.227999999999998,
    "startFrame": 498,
    "endFrame": 577,
    "text": "你会让这个联系人\n读邮件 改日历吗"
  },
  {
    "index": 9,
    "sceneId": "seg-004",
    "startSeconds": 19.578000000000003,
    "endSeconds": 22.58358139534884,
    "startFrame": 587,
    "endFrame": 678,
    "text": "你收到一封邮件\n里面有个会议时间"
  },
  {
    "index": 10,
    "sceneId": "seg-004",
    "startSeconds": 22.58358139534884,
    "endSeconds": 24.587302325581398,
    "startFrame": 678,
    "endFrame": 738,
    "text": "复制日期 打开日历 粘贴"
  },
  {
    "index": 11,
    "sceneId": "seg-004",
    "startSeconds": 24.587302325581398,
    "endSeconds": 26.591023255813955,
    "startFrame": 738,
    "endFrame": 798,
    "text": "再打开待办 补一条提醒"
  },
  {
    "index": 12,
    "sceneId": "seg-004",
    "startSeconds": 26.591023255813955,
    "endSeconds": 30.19772093023256,
    "startFrame": 798,
    "endFrame": 906,
    "text": "邮件里的时间一改\n日历和待办还要跟着改"
  },
  {
    "index": 13,
    "sceneId": "seg-004",
    "startSeconds": 30.19772093023256,
    "endSeconds": 33.60404651162791,
    "startFrame": 906,
    "endFrame": 1008,
    "text": "来回切三个窗口\n只是为了安顿一个日期"
  },
  {
    "index": 14,
    "sceneId": "seg-004",
    "startSeconds": 33.60404651162791,
    "endSeconds": 36.81,
    "startFrame": 1008,
    "endFrame": 1104,
    "text": "Poke 想解决的\n就是这种重复搬运"
  },
  {
    "index": 15,
    "sceneId": "seg-005",
    "startSeconds": 37.160000000000004,
    "endSeconds": 40.52272727272727,
    "startFrame": 1115,
    "endFrame": 1216,
    "text": "最早 团队试过\n从邮件客户端和自动化做起"
  },
  {
    "index": 16,
    "sceneId": "seg-005",
    "startSeconds": 40.52272727272727,
    "endSeconds": 43.325,
    "startFrame": 1216,
    "endFrame": 1300,
    "text": "可访谈里的用户\n不想再学一套界面"
  },
  {
    "index": 17,
    "sceneId": "seg-005",
    "startSeconds": 43.325,
    "endSeconds": 46.12727272727273,
    "startFrame": 1300,
    "endFrame": 1384,
    "text": "于是团队把重点\n转向消息里的对话"
  },
  {
    "index": 18,
    "sceneId": "seg-005",
    "startSeconds": 46.12727272727273,
    "endSeconds": 49.49,
    "startFrame": 1384,
    "endFrame": 1485,
    "text": "Poke 收起新的工作台\n变成一个联系人"
  },
  {
    "index": 19,
    "sceneId": "seg-005",
    "startSeconds": 49.49,
    "endSeconds": 53.6,
    "startFrame": 1485,
    "endFrame": 1608,
    "text": "你不用先找功能\n直接像发消息一样告诉它要做什么"
  },
  {
    "index": 20,
    "sceneId": "seg-006",
    "startSeconds": 53.95000000000001,
    "endSeconds": 56.67533333333334,
    "startFrame": 1619,
    "endFrame": 1700,
    "text": "结果 Beta 用户\n把它带得更远"
  },
  {
    "index": 21,
    "sceneId": "seg-006",
    "startSeconds": 56.67533333333334,
    "endSeconds": 58.232666666666674,
    "startFrame": 1700,
    "endFrame": 1747,
    "text": "有人用它提醒吃药"
  },
  {
    "index": 22,
    "sceneId": "seg-006",
    "startSeconds": 58.232666666666674,
    "endSeconds": 60.17933333333334,
    "startFrame": 1747,
    "endFrame": 1805,
    "text": "有人查天气 问球赛结果"
  },
  {
    "index": 23,
    "sceneId": "seg-006",
    "startSeconds": 60.17933333333334,
    "endSeconds": 62.126000000000005,
    "startFrame": 1805,
    "endFrame": 1864,
    "text": "这些请求已经越过邮箱"
  },
  {
    "index": 24,
    "sceneId": "seg-006",
    "startSeconds": 62.126000000000005,
    "endSeconds": 65.43533333333333,
    "startFrame": 1864,
    "endFrame": 1963,
    "text": "团队又把产品\n往更通用 更主动的方向推"
  },
  {
    "index": 25,
    "sceneId": "seg-006",
    "startSeconds": 65.43533333333333,
    "endSeconds": 69.718,
    "startFrame": 1963,
    "endFrame": 2092,
    "text": "一个邮件助手\n开始接住日常生活里随时冒出来的事"
  },
  {
    "index": 26,
    "sceneId": "seg-007",
    "startSeconds": 70.06800000000001,
    "endSeconds": 72.59850000000002,
    "startFrame": 2102,
    "endFrame": 2178,
    "text": "改变入口以后\n提醒的顺序也变了"
  },
  {
    "index": 27,
    "sceneId": "seg-007",
    "startSeconds": 72.59850000000002,
    "endSeconds": 76.39425000000001,
    "startFrame": 2178,
    "endFrame": 2292,
    "text": "你发 明天提醒我吃药\nPoke 把请求留在对话里"
  },
  {
    "index": 28,
    "sceneId": "seg-007",
    "startSeconds": 76.39425000000001,
    "endSeconds": 78.20175000000002,
    "startFrame": 2292,
    "endFrame": 2346,
    "text": "时间到了 它可以先开口"
  },
  {
    "index": 29,
    "sceneId": "seg-007",
    "startSeconds": 78.20175000000002,
    "endSeconds": 82.17825000000002,
    "startFrame": 2346,
    "endFrame": 2465,
    "text": "邮件该跟进 行程有变化\n提醒也会出现在联系人列表"
  },
  {
    "index": 30,
    "sceneId": "seg-007",
    "startSeconds": 82.17825000000002,
    "endSeconds": 84.34725000000002,
    "startFrame": 2465,
    "endFrame": 2530,
    "text": "你不用记得打开另一套应用"
  },
  {
    "index": 31,
    "sceneId": "seg-007",
    "startSeconds": 84.34725000000002,
    "endSeconds": 87.42000000000002,
    "startFrame": 2530,
    "endFrame": 2623,
    "text": "Poke 会在原来的\n消息窗口里来找你"
  },
  {
    "index": 32,
    "sceneId": "seg-008",
    "startSeconds": 87.77000000000001,
    "endSeconds": 90.96523595505619,
    "startFrame": 2633,
    "endFrame": 2729,
    "text": "但少开一个界面\n还不等于少做那些步骤"
  },
  {
    "index": 33,
    "sceneId": "seg-008",
    "startSeconds": 90.96523595505619,
    "endSeconds": 94.16047191011236,
    "startFrame": 2729,
    "endFrame": 2825,
    "text": "Poke 得到授权以后\n能读邮件和日历"
  },
  {
    "index": 34,
    "sceneId": "seg-008",
    "startSeconds": 94.16047191011236,
    "endSeconds": 96.04002247191012,
    "startFrame": 2825,
    "endFrame": 2881,
    "text": "草拟回复 也能安排会议"
  },
  {
    "index": 35,
    "sceneId": "seg-008",
    "startSeconds": 96.04002247191012,
    "endSeconds": 99.79912359550562,
    "startFrame": 2881,
    "endFrame": 2994,
    "text": "你说 把邮件里的时间放进日历\n它就接着往下做"
  },
  {
    "index": 36,
    "sceneId": "seg-008",
    "startSeconds": 99.79912359550562,
    "endSeconds": 104.498,
    "startFrame": 2994,
    "endFrame": 3135,
    "text": "复制 粘贴和切换可以交给它\n真实账户里的改动也会留下来"
  },
  {
    "index": 37,
    "sceneId": "seg-009",
    "startSeconds": 104.84800000000001,
    "endSeconds": 107.22444859813085,
    "startFrame": 3145,
    "endFrame": 3217,
    "text": "能做的事情一多\n设置也变复杂"
  },
  {
    "index": 38,
    "sceneId": "seg-009",
    "startSeconds": 107.22444859813085,
    "endSeconds": 109.60089719626168,
    "startFrame": 3217,
    "endFrame": 3288,
    "text": "一个人已经写好背景 接上服务"
  },
  {
    "index": 39,
    "sceneId": "seg-009",
    "startSeconds": 109.60089719626168,
    "endSeconds": 112.70856074766355,
    "startFrame": 3288,
    "endFrame": 3381,
    "text": "另一个人想用同样的助手\n还要重来一遍"
  },
  {
    "index": 40,
    "sceneId": "seg-009",
    "startSeconds": 112.70856074766355,
    "endSeconds": 115.81622429906542,
    "startFrame": 3381,
    "endFrame": 3474,
    "text": "Recipe 是 Poke 里的\n分享功能"
  },
  {
    "index": 41,
    "sceneId": "seg-009",
    "startSeconds": 115.81622429906542,
    "endSeconds": 119.83790654205607,
    "startFrame": 3474,
    "endFrame": 3595,
    "text": "它把背景 第一句话\n和需要连接的服务装进一个链接"
  },
  {
    "index": 42,
    "sceneId": "seg-009",
    "startSeconds": 119.83790654205607,
    "endSeconds": 122.03155140186917,
    "startFrame": 3595,
    "endFrame": 3661,
    "text": "别人点开后\n从这套设置开始"
  },
  {
    "index": 43,
    "sceneId": "seg-009",
    "startSeconds": 122.03155140186917,
    "endSeconds": 124.408,
    "startFrame": 3661,
    "endFrame": 3732,
    "text": "涉及账户时\n授权仍要自己完成"
  },
  {
    "index": 44,
    "sceneId": "seg-010",
    "startSeconds": 124.75800000000001,
    "endSeconds": 126.79457142857144,
    "startFrame": 3743,
    "endFrame": 3804,
    "text": "开放使用之后\n消息开始累积"
  },
  {
    "index": 45,
    "sceneId": "seg-010",
    "startSeconds": 126.79457142857144,
    "endSeconds": 128.15228571428574,
    "startFrame": 3804,
    "endFrame": 3845,
    "text": "收购前大约三个月"
  },
  {
    "index": 46,
    "sceneId": "seg-010",
    "startSeconds": 128.15228571428574,
    "endSeconds": 132.73457142857146,
    "startFrame": 3845,
    "endFrame": 3982,
    "text": "Cognition 披露\n人们与 Poke 往来超过一亿条消息"
  },
  {
    "index": 47,
    "sceneId": "seg-010",
    "startSeconds": 132.73457142857146,
    "endSeconds": 135.9591428571429,
    "startFrame": 3982,
    "endFrame": 4079,
    "text": "每次请求和回复\n都留在同一个联系人对话里"
  },
  {
    "index": 48,
    "sceneId": "seg-010",
    "startSeconds": 135.9591428571429,
    "endSeconds": 139.014,
    "startFrame": 4079,
    "endFrame": 4170,
    "text": "这个入口最终堆出了\n一个很大的消息数字"
  },
  {
    "index": 49,
    "sceneId": "seg-011",
    "startSeconds": 139.364,
    "endSeconds": 141.86440000000002,
    "startFrame": 4181,
    "endFrame": 4256,
    "text": "这些实时动作\n也在持续调用模型"
  },
  {
    "index": 50,
    "sceneId": "seg-011",
    "startSeconds": 141.86440000000002,
    "endSeconds": 143.47180000000003,
    "startFrame": 4256,
    "endFrame": 4304,
    "text": "创始人举过两个例子"
  },
  {
    "index": 51,
    "sceneId": "seg-011",
    "startSeconds": 143.47180000000003,
    "endSeconds": 147.22240000000002,
    "startFrame": 4304,
    "endFrame": 4417,
    "text": "新邮件一到就跑自动化\n查航班状态还要不断刷新"
  },
  {
    "index": 52,
    "sceneId": "seg-011",
    "startSeconds": 147.22240000000002,
    "endSeconds": 150.25860000000003,
    "startFrame": 4417,
    "endFrame": 4508,
    "text": "任务没结束\n推理调用也不会只发生一次"
  },
  {
    "index": 53,
    "sceneId": "seg-011",
    "startSeconds": 150.25860000000003,
    "endSeconds": 154.00920000000002,
    "startFrame": 4508,
    "endFrame": 4620,
    "text": "一句很短的请求\n背后可能是一串持续运行的调用"
  },
  {
    "index": 54,
    "sceneId": "seg-011",
    "startSeconds": 154.00920000000002,
    "endSeconds": 156.68820000000002,
    "startFrame": 4620,
    "endFrame": 4701,
    "text": "他说 Poke 运行昂贵\n也很难盈利"
  },
  {
    "index": 55,
    "sceneId": "seg-011",
    "startSeconds": 156.68820000000002,
    "endSeconds": 160.796,
    "startFrame": 4701,
    "endFrame": 4824,
    "text": "随后 Cognition\n收购了开发 Poke 的公司"
  },
  {
    "index": 56,
    "sceneId": "seg-012",
    "startSeconds": 161.146,
    "endSeconds": 163.43816438356163,
    "startFrame": 4834,
    "endFrame": 4903,
    "text": "收购当下\nPoke 继续照常使用"
  },
  {
    "index": 57,
    "sceneId": "seg-012",
    "startSeconds": 163.43816438356163,
    "endSeconds": 167.53131506849314,
    "startFrame": 4903,
    "endFrame": 5026,
    "text": "Cognition 计划把它接上\n自己的模型和基础设施"
  },
  {
    "index": 58,
    "sceneId": "seg-012",
    "startSeconds": 167.53131506849314,
    "endSeconds": 172.2793698630137,
    "startFrame": 5026,
    "endFrame": 5168,
    "text": "TechCrunch 报道 至少到\n2026 年底 产品不会立刻改变"
  },
  {
    "index": 59,
    "sceneId": "seg-012",
    "startSeconds": 172.2793698630137,
    "endSeconds": 176.20879452054794,
    "startFrame": 5168,
    "endFrame": 5286,
    "text": "之后会不会完全并入\nCognition 当时仍未确定"
  },
  {
    "index": 60,
    "sceneId": "seg-012",
    "startSeconds": 176.20879452054794,
    "endSeconds": 178.33723287671233,
    "startFrame": 5286,
    "endFrame": 5350,
    "text": "对用户来说\n眼前的交换没有变"
  },
  {
    "index": 61,
    "sceneId": "seg-012",
    "startSeconds": 178.33723287671233,
    "endSeconds": 181.61175342465754,
    "startFrame": 5350,
    "endFrame": 5448,
    "text": "少开几个窗口\n换来一个能动真实账户的联系人"
  },
  {
    "index": 62,
    "sceneId": "seg-012",
    "startSeconds": 181.61175342465754,
    "endSeconds": 185.04999999999998,
    "startFrame": 5448,
    "endFrame": 5551,
    "text": "下一次它把会议挪错\n你还会不会让它继续改日历"
  }
]
