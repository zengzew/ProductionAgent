{
  "segments": [
    {
      "segmentId": "seg-001",
      "cues": [
        "一张商品照",
        "AI帮你抠图、换背景"
      ]
    },
    {
      "segmentId": "seg-002",
      "cues": [
        "Photoroom的创始人马修",
        "在GoPro做产品时",
        "就嫌抠图麻烦",
        "后来干脆回去学了机器学习"
      ]
    },
    {
      "segmentId": "seg-003",
      "cues": [
        "他和工程师埃利奥特搭档",
        "两周就做出了\n第一版Photoroom"
      ]
    },
    {
      "segmentId": "seg-004",
      "cues": [
        "现在，卖家放进商品照片",
        "就能去掉杂乱背景",
        "再换成白底",
        "或者生成新的场景"
      ]
    },
    {
      "segmentId": "seg-005",
      "cues": [
        "马修在访谈里强调",
        "背景可以变",
        "商品的细节和瑕疵要留下",
        "毕竟，卖家卖的是手里的真东西"
      ]
    },
    {
      "segmentId": "seg-006",
      "cues": [
        "获客也围着这个效果做",
        "增长负责人说",
        "免费抠图是他们的获客入口",
        "团队还在TikTok演示",
        "图片前后的变化"
      ]
    },
    {
      "segmentId": "seg-007",
      "cues": [
        "他们联系主动发布演示的用户合作",
        "再把好内容拿去投广告"
      ]
    },
    {
      "segmentId": "seg-008",
      "cues": [
        "2024年，公司披露",
        "拿到四千三百万美元B轮融资"
      ]
    },
    {
      "segmentId": "seg-009",
      "cues": [
        "它接住的",
        "就是小卖家每天都要做的事",
        "把手里的货",
        "清清楚楚地摆到买家面前"
      ]
    }
  ]
}
