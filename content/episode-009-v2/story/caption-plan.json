{
  "segments": [
    {
      "segmentId": "seg-001",
      "cues": [
        "给一个网址",
        "AI帮你做宣传短视频"
      ]
    },
    {
      "segmentId": "seg-002",
      "cues": [
        "Fastlane的创始人高拉夫",
        "做出几个应用后",
        "才发现还有个难题",
        "怎么让人看见",
        "他又不想一开始就砸钱投广告"
      ]
    },
    {
      "segmentId": "seg-003",
      "cues": [
        "他和伙伴做的这个工具",
        "会读取网站",
        "参考相关的热门内容",
        "再生成介绍你产品的",
        "图文和短视频"
      ]
    },
    {
      "segmentId": "seg-004",
      "cues": [
        "不喜欢的划走",
        "想用的留下",
        "选好账号，就能安排发布"
      ]
    },
    {
      "segmentId": "seg-005",
      "cues": [
        "原来要一边开发",
        "一边想选题、写文案、剪视频",
        "现在先有一批候选",
        "用户把时间花在挑选和调整上"
      ]
    },
    {
      "segmentId": "seg-006",
      "cues": [
        "那第一批人从哪来",
        "他们去Reddit和社交平台招募",
        "再约报名者通话"
      ]
    },
    {
      "segmentId": "seg-007",
      "cues": [
        "通话时让对方共享屏幕",
        "自己少说话",
        "看他在哪一步卡住",
        "再照着这些问题改界面"
      ]
    },
    {
      "segmentId": "seg-008",
      "cues": [
        "为了让人愿意聊",
        "应用里还有个邀请",
        "参加访谈，多送七天使用时间"
      ]
    },
    {
      "segmentId": "seg-009",
      "cues": [
        "第一位付费客户",
        "就是一名测试用户",
        "他付钱的理由很直接",
        "还想接着用"
      ]
    },
    {
      "segmentId": "seg-010",
      "cues": [
        "高拉夫早期披露的",
        "年化经常性收入",
        "已超过十二万澳元"
      ]
    },
    {
      "segmentId": "seg-011",
      "cues": [
        "当初，他为自己的应用找推广办法",
        "这份麻烦做成工具",
        "成了别人愿意付钱买的服务"
      ]
    }
  ]
}
