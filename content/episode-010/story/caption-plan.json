{
  "segments": [
    {
      "segmentId": "seg-001",
      "cues": [
        "开会记几个词",
        "AI补成完整笔记"
      ]
    },
    {
      "segmentId": "seg-002",
      "cues": [
        "Granola的创始人克里斯",
        "在意的，是普通AI纪要的一个毛病",
        "看着完整，却未必记住你的重点"
      ]
    },
    {
      "segmentId": "seg-003",
      "cues": [
        "他和团队换了个思路",
        "让你随手记下的要点",
        "告诉AI什么最重要"
      ]
    },
    {
      "segmentId": "seg-004",
      "cues": [
        "会议里，你照常写几个关键词",
        "Granola在后台转写",
        "结束后，再把你写的\n和会上说的合在一起"
      ]
    },
    {
      "segmentId": "seg-005",
      "cues": [
        "像这段演示，几条零散记录",
        "就展开成了分好层次的笔记",
        "开会时，不用为了记全每句话",
        "一直盯着键盘"
      ]
    },
    {
      "segmentId": "seg-006",
      "cues": [
        "他们先和一小群测试用户打磨",
        "再公开推出",
        "早期用的人里",
        "有经常听项目的投资人",
        "也有创业公司负责人"
      ]
    },
    {
      "segmentId": "seg-007",
      "cues": [
        "按公司当时的说法",
        "产品会从负责人传到团队",
        "笔记也能一键分享给同事"
      ]
    },
    {
      "segmentId": "seg-008",
      "cues": [
        "到二零二六年三月",
        "公司宣布新融了",
        "一亿两千五百万美元",
        "估值十五亿美元"
      ]
    },
    {
      "segmentId": "seg-009",
      "cues": [
        "回头看那几个关键词",
        "它们留下的是你的判断",
        "AI补上的，是让这份判断",
        "能被同事看懂的细节"
      ]
    }
  ]
}
