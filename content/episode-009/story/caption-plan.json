{
  "segments": [
    {
      "segmentId": "seg-001",
      "cues": [
        "产品有了，宣传视频怎么拍"
      ]
    },
    {
      "segmentId": "seg-002",
      "cues": [
        "Fastlane把产品链接",
        "变成一组营销内容"
      ]
    },
    {
      "segmentId": "seg-003",
      "cues": [
        "一张张滑着挑",
        "不喜欢就跳过",
        "喜欢就留下"
      ]
    },
    {
      "segmentId": "seg-004",
      "cues": [
        "挑好内容",
        "再选账号",
        "现在发",
        "还是排到以后",
        "也能在这里选"
      ]
    },
    {
      "segmentId": "seg-005",
      "cues": [
        "这也是创始人自己的难题",
        "应用做出来了",
        "却卡在怎么让人看见"
      ]
    },
    {
      "segmentId": "seg-006",
      "cues": [
        "找第一批用户",
        "他们去Reddit",
        "和社交平台找人",
        "再发邮件约报名者通话"
      ]
    },
    {
      "segmentId": "seg-007",
      "cues": [
        "应用里还放了个预约按钮",
        "聊一次，就多送七天使用时间"
      ]
    },
    {
      "segmentId": "seg-008",
      "cues": [
        "通话时让对方共享屏幕",
        "少说话",
        "先看人卡在哪",
        "再改界面"
      ]
    },
    {
      "segmentId": "seg-009",
      "cues": [
        "收入呢？二零二六年四月",
        "创始人自报",
        "年化经常性收入",
        "超过十二万澳元"
      ]
    },
    {
      "segmentId": "seg-010",
      "cues": [
        "做产品的人",
        "不必每条宣传都从空白开始",
        "有了内容，挑好",
        "再排期发出去"
      ]
    }
  ]
