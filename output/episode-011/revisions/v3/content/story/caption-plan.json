  "segments": [
    {
      "segmentId": "seg-001",
      "cues": [
        "输入文字",
        "AI帮你生成PPT"
      ]
    },
    {
      "segmentId": "seg-002",
      "cues": [
        "Gamma的创始人格兰特做咨询时",
        "曾为第二天的会议熬夜准备",
        "他说，大量工夫花在排版",
        "内容反而顾不上"
      ]
    },
    {
      "segmentId": "seg-003",
      "cues": [
        "他找来两位老同事",
        "想把顺序倒过来",
        "先把话写清楚",
        "再让工具处理版式"
      ]
    },
    {
      "segmentId": "seg-004",
      "cues": [
        "Gamma后来接入AI",
        "输入主题或已有文字",
        "选个样式",
        "就能得到配好图文的初稿"
      ]
    },
    {
      "segmentId": "seg-005",
      "cues": [
        "想换一种表达",
        "还能让AI改布局",
        "或把文字变成图示",
        "你要做的，是核对内容、调整重点"
      ]
    },
    {
      "segmentId": "seg-006",
      "cues": [
        "他们拿下了Product Hunt\n月榜第一",
        "增长却还是卡住了"
      ]
    },
    {
      "segmentId": "seg-007",
      "cues": [
        "十二个人花了三个月",
        "重新打磨用户进来的前三十秒",
        "输入一句话",
        "先看到一份PPT"
      ]
    },
    {
      "segmentId": "seg-008",
      "cues": [
        "二零二五年十一月",
        "Gamma自报年化经常性收入\n突破一亿美元",
        "到二零二六年八月",
        "公司披露累计用户已超一亿"
      ]
    },
    {
      "segmentId": "seg-009",
      "cues": [
        "做PPT",
        "不必再从空白页一页页排起",
        "输入文字，先有初稿，再动手改",
        "就这样，Gamma干掉了PPT"
      ]
    }
  ]
}
