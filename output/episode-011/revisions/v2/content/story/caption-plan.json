  "segments": [
    {
      "segmentId": "seg-001",
      "cues": [
        "输入文字",
        "AI帮你生成PPT"
      ]
    },
    {
      "segmentId": "seg-002",
      "cues": [
        "Gamma的创始人格兰特做咨询时",
        "曾为第二天的会议熬夜准备",
        "他说，大量工夫花在排版",
        "内容反而顾不上"
      ]
    },
    {
      "segmentId": "seg-003",
      "cues": [
        "他找来两位老同事",
        "想把顺序倒过来",
        "先把话写清楚",
        "再让工具处理版式"
      ]
    },
    {
      "segmentId": "seg-004",
      "cues": [
        "Gamma后来接入AI",
        "输入主题或已有文字",
        "选个样式",
        "就能得到配好图文的初稿"
      ]
    },
    {
      "segmentId": "seg-005",
      "cues": [
        "想换一种表达",
        "还能让AI改布局",
        "或把文字变成图示",
        "你要做的，是核对内容、调整重点"
      ]
    },
    {
      "segmentId": "seg-006",
      "cues": [
        "第一批用户，是他们找来的朋友",
        "公开测试时\n又去Product Hunt发布",
        "让陌生人直接注册"
      ]
    },
    {
      "segmentId": "seg-007",
      "cues": [
        "格兰特说，他们还主动邀请用户通话",
        "问清楚哪里不好用",
        "再继续改"
      ]
    },
    {
      "segmentId": "seg-008",
      "cues": [
        "二零二五年十一月",
        "Gamma自报年化经常性收入\n突破一亿美元",
        "到二零二六年八月",
        "公司披露累计用户已超一亿"
      ]
    },
    {
      "segmentId": "seg-009",
      "cues": [
        "从熬夜排版",
        "到输入文字就有初稿",
        "就这样，Gamma把做PPT\n变成了先生成、再修改"
      ]
    }
  ]
